{
  "apiVersion": "skiff.dev/plugin/v1alpha1",
  "kind": "Plugin",
  "name": "kafka",
  "version": "1.0.0",
  "runtime": {"kind": "command", "command": ["kafka-plugin"]},
  "hooks": ["doctor_checks", "package_step"],
  "permissions": {
    "doctor_checks": true,
    "package_step_kinds": [
      "package.partition_quorum.verify_quorum",
      "package.partition_quorum.update_non_leaders",
      "package.partition_quorum.verify_in_sync_replicas",
      "package.partition_quorum.move_leaders",
      "package.partition_quorum.update_previous_leaders",
      "package.partition_quorum.verify_final",
      "kafka.verify_cluster",
      "kafka.verify_isr",
      "kafka.verify_no_under_replicated_partitions",
      "kafka.move_leadership",
      "kafka.verify_broker_caught_up"
    ]
  },
  "capabilities": [
    {"kind": "doctor_check", "name": "kafka-doctor", "doctor_checks": ["kafka.cluster", "kafka.isr", "kafka.under_replicated_partitions"]},
    {
      "kind": "package_step",
      "name": "kafka-partition-safety",
      "package_steps": [
        {"kind": "package.partition_quorum.verify_quorum", "summary": "verify broker exclusion preserves min ISR", "risk": "low", "reversibility": "reversible"},
        {"kind": "package.partition_quorum.update_non_leaders", "summary": "update brokers that are not partition leaders first", "risk": "medium", "reversibility": "compensatable"},
        {"kind": "package.partition_quorum.verify_in_sync_replicas", "summary": "verify ISR before moving partition leaders", "risk": "low", "reversibility": "reversible"},
        {"kind": "package.partition_quorum.move_leaders", "summary": "move partition leadership before updating leaders", "risk": "high", "reversibility": "partially_reversible"},
        {"kind": "package.partition_quorum.update_previous_leaders", "summary": "update previous leaders after leadership moves", "risk": "medium", "reversibility": "compensatable"},
        {"kind": "package.partition_quorum.verify_final", "summary": "verify final ISR and leadership state", "risk": "low", "reversibility": "reversible"},
        {"kind": "kafka.verify_cluster", "summary": "verify KRaft controller and broker health", "risk": "low", "reversibility": "reversible"},
        {"kind": "kafka.verify_isr", "summary": "verify partitions preserve min.insync.replicas", "risk": "low", "reversibility": "reversible"},
        {"kind": "kafka.verify_no_under_replicated_partitions", "summary": "block normal update while partitions are under-replicated", "risk": "low", "reversibility": "reversible"},
        {"kind": "kafka.move_leadership", "summary": "move leadership away from the broker being updated", "risk": "high", "reversibility": "partially_reversible"},
        {"kind": "kafka.verify_broker_caught_up", "summary": "verify broker catch-up before continuing", "risk": "low", "reversibility": "reversible"}
      ]
    }
  ]
}
